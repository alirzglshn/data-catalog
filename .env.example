DJANGO_SECRET_KEY=change-to-a-random-fifty-character-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=datacatalog
POSTGRES_USER=datacatalog
POSTGRES_PASSWORD=datacatalog
POSTGRES_HOST=db
POSTGRES_PORT=5432

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=1

# --- email -------------------------------------------------------
#
# option a, default: deliver through the bundled postfix container,
# no external account needed, mail can be inspected with
# `docker compose logs postfix` or by exec-ing into the container
#
#   EMAIL_HOST=postfix
#   EMAIL_PORT=25
#   EMAIL_USE_TLS=False
#   EMAIL_HOST_USER=
#   EMAIL_HOST_PASSWORD=
#
# option b: deliver through a real gmail account so the notification
# lands in an actual inbox, uncomment and fill in the four lines
# below (leave EMAIL_HOST=postfix and the others commented to use
# option a instead)
#
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=your-address@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-character-app-password
#
# gmail refuses plain account passwords over smtp, an app password
# must be generated at https://myaccount.google.com/apppasswords
# (requires 2-step verification to be enabled on the account first)

EMAIL_HOST=postfix
EMAIL_PORT=25
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=catalog@datacatalog.local
NOTIFY_EMAIL_RECIPIENT=admin@datacatalog.local

DJANGO_LOG_LEVEL=INFO
